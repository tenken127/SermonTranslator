# SermonTranslator Environment Variables Template
# Copy this file to .env and insert your personal API keys.
# NEVER commit your actual .env file to Git!

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=

# DeepL Translate API Key (https://www.deepl.com/pro-api)
DEEPL_API_KEY=

# ElevenLabs Voice API Key (https://elevenlabs.io/)
ELEVENLABS_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Admin Dashboard Access PIN
ADMIN_PIN=7777
